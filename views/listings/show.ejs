<% layout("layouts/boilerplate")%>

<div class="row mt-3 mb-3">
  <div class="col-8 offset-3">
    <h3><%= listing.title%></h3>
  </div>

  <div class="card col-6 offset-3">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="Listing images"
    />
    <div class="card-body">
      <div class="card-text">
        <p><b>Owner:</b> <%= listing.owner ? listing.owner.username : "Anonymous" %></p>

        <p><%= listing.description %></p>

        <p>&#8377; <%= listing.price.toLocaleString("en-IN") %></p>

        <p><%= listing.location %></p>

        <p><%= listing.country %></p>
      </div>
    </div>
  </div>
  <% if(currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
  <div class="btns mb-3">
    <a
      href="/listings/<%= listing._id %>/edit"
      class="btn btn-dark col-1 offset-3 edit-btn"
      >Edit</a
    >

    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
      <button class="btn btn-dark offset-5">Delete</button>
    </form>
  </div>
  <% } %>

  <!-- Map Container Added Here -->
  <div class="col-8 offset-3 mb-3">
    <h3>Where you'll be</h3>
    <div id="map" style="height: 400px; width: 100%; border-radius: 1rem;"></div>
  </div>

  <!-- review form -->
   
  <div class="col-8 offset-3 mb-3">
    <% if(currentUser) { %>
    <h4>Reviews</h4>
    <form
      action="/listings/<%= listing._id %>/reviews"
      method="post"
      novalidate
      class="needs-validation"
    >
      <div class="mb-3 mt-3">
        <label for="rating">Rating</label>
        <input
          type="range"
          name="review[rating]"
          id="rating"
          min="1"
          max="5"
          class="form-range"
        />
      </div>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comment</label><br />
        <textarea
          name="review[comment]"
          id="comment"
          cols="10"
          rows="3"
          class="form-control" 
          required
        ></textarea>
        <div class="invalid-feedback">Please provide a comment.</div>
        <div class="valid-feedback">Looks good!</div>
      </div>
      <button type="submit" class="btn btn-dark mb-3 mt-3">Submit</button>
    </form>
    <% } %>


    <!-- all reviews -->
    <hr />
    <p><b>All Reviews</b></p>

    <div class="row">
      <% for(let review of listing.reviews) { %>
      <div class="card col-5 ms-3 mb-3">
        <div class="card-body">
          <h5 class="card-title">@<%= review.author ? review.author.username : "Anonymous" %></h5>
          <p class="card-text"><%= review.comment %></p>
          <div class="d-flex justify-content-between align-items-center mt-3">
            
            <div>
              <% for(let i = 0; i < review.rating; i++) { %>
                <i class="fa-solid fa-star star"></i>
              <% } %>
            </div>
            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-0">
              <button class="btn btn-sm text-danger border-0 p-1" title="Delete Review">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </form>
          </div>
        </div>
      </div>
      <% } %>
    </div>

  </div>
</div>

<!-- Define hardcoded coordinates so map.js can read them -->
<!-- <script>
    const coordinates = { lat: 28.6139, lng: 77.209 };
</script> -->
<script>
      const coordinates = {
      lat: Number("<%= (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length) ? listing.geometry.coordinates[1] : 28.6139 %>"),
      lng: Number("<%= (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length) ? listing.geometry.coordinates[0] : 77.209 %>")
    };
    const listingTitle = "<%= listing.title %>";
    const listingLocation = "<%= listing.location %>";
</script>
<script src="/js/map.js"></script>
<script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.MAP_KEY %>&callback=initMap"></script>