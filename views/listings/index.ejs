<% layout("layouts/boilerplate")%>

<style> 
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter {
    margin: 0.5rem 0.8rem;
    text-align: center;
    opacity: 0.7;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    font-size: 0.8rem;
    transition: 0.2s ease;
  }
  .filter:hover,
  .filter.active {
    opacity: 1;
    border-bottom: 2px solid black;
  }
  .filter p {
    margin-bottom: 0;
  }
  .tax-info {
    display: none;
  }
  .tax-toggle {
    border: 1px solid rgba(0, 0, 0, 0.5);
    border-radius: 5rem;
    height: 2.5rem;
    padding: 1rem;
    margin-left: 3rem;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
  }

</style>

<div class="filters">
  <a href="/listings" class="filter <%= (typeof selectedCategory === 'undefined' || !selectedCategory) ? 'active' : '' %>">
    <div><i class="fa-solid fa-border-all"></i></div>
    <p>All</p>
  </a>
  <a href="/listings?category=trending" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'trending' ? 'active' : '' %>">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </a>
  <a href="/listings?category=rooms" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'rooms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>
  <a href="/listings?category=iconic cities" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'iconic cities' ? 'active' : '' %>">
    <div><i class="fa-solid fa-city"></i></div>
    <p>Iconic cities</p>
  </a>
  <a href="/listings?category=amazing pools" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'amazing pools' ? 'active' : '' %>">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing pools</p>
  </a>
  <a href="/listings?category=mountain" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'mountain' ? 'active' : '' %>">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountain</p>
  </a>
  <a href="/listings?category=snow" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'snow' ? 'active' : '' %>">
    <div><i class="fa-solid fa-snowflake"></i></div>
    <p>Snow</p>
  </a>
  <a href="/listings?category=tree" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'tree' ? 'active' : '' %>">
    <div><i class="fa-solid fa-tree"></i></div>
    <p>Tree</p>
  </a>
  <a href="/listings?category=castle" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'castle' ? 'active' : '' %>">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castle</p>
  </a>
  <a href="/listings?category=farms" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'farms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </a>
  <a href="/listings?category=price" class="filter <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'price' ? 'active' : '' %>">
    <div><i class="fa-solid fa-money-bill-wave"></i></div>
    <p>Price</p>
  </a>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="taxSwitch"
        
      />
      <label class="form-check-label" for="taxSwitch">Show Tax</label>
    </div>
  </div>
</div>

<% if(allListings.length === 0) { %>
  <div class="col-12 text-center mt-5 mb-5">
    <h4>No listings found for this category!</h4>
    <a href="/listings" class="btn btn-dark mt-3">View All Listings</a>
  </div>
<% } else { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
      <a href="/listings/<%= listing._id%>" class="listing-link">
        <div class="card col listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing images" style="height: 20rem">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title%></b> <br>
              &#8377; <%= listing.price.toLocaleString("en-IN") %>/night
              <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
<% } %>
<script>
let taxSwitch = document.getElementById("taxSwitch");
taxSwitch.addEventListener("click", () => {
  
  let taxInfoElements = document.querySelectorAll(".tax-info");
  for ( let info of taxInfoElements) {

    if (info.style.display !== "inline") {
      info.style.display = "inline";
    } else {
      info.style.display = "none";
    }
  }
});
     
</script>